# --- LLM provider ----------------------------------------------------------
# The whole project builds its model through orbit.config.make_llm(), so
# switching providers is an .env change and nothing else. No layer hard-codes
# a model or a provider.
#   anthropic  -> direct Anthropic, bare model id      (claude-sonnet-4-6)
#   openrouter -> OpenRouter gateway, PREFIXED id      (anthropic/claude-sonnet-4.6)
ORBIT_LLM_PROVIDER=openrouter

# OpenRouter: one gateway to many models, and a useful fallback when the
# shared Anthropic key is rate-limited. Model ids MUST be provider-prefixed.
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME
ORBIT_MODEL=anthropic/claude-sonnet-4.6

# --- Shared Claude account -------------------------------------------------
# The SAME Anthropic account for all three developers, so this is ONE key
# shared by the whole team. A shared key = shared rate limits. Read the
# "Shared Claude account" section in your DEV_*.md before running the agent.
# Leave blank while ORBIT_LLM_PROVIDER=openrouter.
ANTHROPIC_API_KEY=

# Optional: a Browser Use Cloud key can reach Claude too (provider-prefixed
# model ids), so you may not need the Anthropic key directly.
# BROWSER_USE_API_KEY=

# --- Exa web search (optional) ---------------------------------------------
# A SUPPORTING research tool only (orbit.agent.tools). The headline demo stays
# browser-native — "the browser is the integration layer" is the thesis, so no
# demo flow should depend on Exa.
EXA_API_KEY=REPLACE_ME

# --- Orbit runtime ---------------------------------------------------------
# Put YOUR name here so shared-key usage is traceable in logs.
ORBIT_DEV_TAG=your-name
ORBIT_PORTAL_URL=http://127.0.0.1:5000
ORBIT_HEADLESS=false
